# RefinedC donor toolchain pins (pattern: opendnp3-verified/scripts/pins.env).
# Recorded 2026-08-29 at initial setup; move only deliberately.

# RefinedC commit built in .refinedc-ws (= deps/refinedc checkout = upstream
# HEAD at setup time; clone origin is the local deps checkout).
REFINEDC_COMMIT="25f706d417df2b18b23c5cbadde46468c1b1262c"

# cerberus-lib pin for the frontend (from refinedc's Makefile builddep-pins,
# verbatim).
CERBERUS_LIB_PIN="git+https://github.com/rems-project/cerberus.git#f11e6b335a687c1b77539f7e5695607d09dfc3ea"

# Donor-prescribed compiler (DEVELOPERS.md verbatim).
OCAML_SWITCH_PKGS="ocaml-variants.4.14.2+options ocaml-option-flambda"

# Coq/iris constraints live in the .opam files at REFINEDC_COMMIT
# (coq 9.1.0, rocq-iris dev.2026-07-16.1.b8aa3470, rocq-stdpp-unstable,
# coq-record-update 0.3.6); resolution happens through the coq-released +
# iris-dev opam repos added to the LOCAL opam root only.
