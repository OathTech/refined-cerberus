proc set (p: pointer): eff unit :=
  let strong _: loaded integer =
    bound(
      let weak a_528: pointer =
        let weak a_529: loaded pointer =
          let weak a_532: pointer = pure(p) in
          load('signed int*', a_532) in
        case a_529 of
          | Specified(a_530: pointer) =>
              let weak a_531: boolean =
                memop(PtrValidForDeref, 'signed int', a_530) in
              pure(
                if a_531 then
                  a_530
                else
                  undef(<<UB043_indirection_invalid_value>>)
              )
          | Unspecified(_: ctype) =>
              pure(undef(<<UB043_indirection_invalid_value>>))
        end in
      let weak a_533: loaded integer = pure(Specified(4)) in
      let weak _: unit =
        neg(store('signed int', a_528, conv_loaded_int('signed int', a_533))) in
      pure(conv_loaded_int('signed int', a_533))
    ) in
  pure(Unit) ;
  pure(Unit) ;
  save ret_527: unit (a_534: unit:= Unit) in  pure(a_534)

