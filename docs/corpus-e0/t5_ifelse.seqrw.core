proc main (): eff loaded integer :=
  let strong x: pointer = create(Ivalignof('signed int'), 'signed int') in
  let strong r: pointer = create(Ivalignof('signed int'), 'signed int') in
  store('signed int', x, conv_loaded_int('signed int', Specified(3))) ;
  store('signed int', r, Unspecified('signed int')) ;
  let strong a_510: loaded integer =
    bound(
      let weak a_512: loaded integer =
        let weak a_518: loaded integer = load('signed int', x) in
        let weak a_519: loaded integer = pure(Specified(2)) in
        case (a_518, a_519) of
          | (Specified(a_520: integer), Specified(a_521: integer)) =>
              pure(
                if conv_int('signed int', a_520) > conv_int('signed int', a_521) then
                  Specified(1)
                else
                  Specified(0)
              )
          | _: (loaded integer,loaded integer) =>
              pure(Unspecified('signed int'))
        end in
      let weak a_513: loaded integer = pure(Specified(0)) in
      pure(
        case (a_512, a_513) of
          | (Specified(a_514: integer), Specified(a_515: integer)) =>
              if conv_int('signed int', a_514) = conv_int('signed int', a_515) then
                Specified(1)
              else
                Specified(0)
          | _: (loaded integer,loaded integer) =>
              Unspecified('signed int')
        end
      )
    ) in
  let strong a_509: boolean =
    case a_510 of
      | Specified(a_511: integer) =>
          pure(if not(a_511 = 1) then True else False)
      | Unspecified(_: ctype) =>
          nd(pure(True), pure(False))
    end in
  if a_509 then
    let strong _: loaded integer =
      bound(
        let weak _: unit =
          neg(store('signed int', r, conv_loaded_int('signed int', Specified(1)))) in
        pure(conv_loaded_int('signed int', Specified(1)))
      ) in
    pure(Unit)
  else
    let strong _: loaded integer =
      bound(
        let weak _: unit =
          neg(store('signed int', r, conv_loaded_int('signed int', Specified(0)))) in
        pure(conv_loaded_int('signed int', Specified(0)))
      ) in
    pure(Unit) ;
  let strong a_528: loaded integer = bound(load('signed int', r)) in
  kill('signed int', x) ;
  kill('signed int', r) ;
  run ret_507(conv_loaded_int('signed int', a_528)) ;
  kill('signed int', x) ;
  kill('signed int', r) ;
  save ret_507: loaded integer (a_529: loaded integer:= Specified(0)) in
    pure(a_529)

