-- Aggregates
def struct P :=
  a: 'signed int'
  b: 'signed int'

-- Fun map
proc main (): eff loaded integer :=
  let strong p: pointer = create(Ivalignof('struct P'), 'struct P') in
  store('struct P', p, Unspecified('struct P')) ;
  let strong _: loaded integer =
    bound(
      let weak (a_508: pointer, a_510: loaded integer) =
        unseq(
          let strong a_509: pointer = pure(p) in
          pure(member_shift(a_509, P, .a))
        ,
          pure(Specified(1))
        ) in
      let weak _: unit =
        neg(store('signed int', a_508, conv_loaded_int('signed int', a_510))) in
      pure(conv_loaded_int('signed int', a_510))
    ) in
  pure(Unit) ;
  let strong _: loaded integer =
    bound(
      let weak (a_511: pointer, a_513: loaded integer) =
        unseq(
          let strong a_512: pointer = pure(p) in
          pure(member_shift(a_512, P, .b))
        ,
          pure(Specified(2))
        ) in
      let weak _: unit =
        neg(store('signed int', a_511, conv_loaded_int('signed int', a_513))) in
      pure(conv_loaded_int('signed int', a_513))
    ) in
  pure(Unit) ;
  let strong a_523: loaded integer =
    bound(
      let weak (a_514: loaded integer, a_515: loaded integer) =
        unseq(
          let weak a_520: pointer =
            let strong a_519: pointer = pure(p) in
            pure(member_shift(a_519, P, .a)) in
          load('signed int', a_520)
        ,
          let weak a_522: pointer =
            let strong a_521: pointer = pure(p) in
            pure(member_shift(a_521, P, .b)) in
          load('signed int', a_522)
        ) in
      pure(
        case (a_514, a_515) of
          | (Specified(a_516: integer), Specified(a_517: integer)) =>
              Specified(catch_exceptional_condition_add('signed int', __conv_int__('signed int', a_516), __conv_int__('signed int', a_517)))
          | _: (loaded integer,loaded integer) =>
              undef(<<UB036_exceptional_condition>>)
        end
      )
    ) in
  kill('struct P', p) ;
  run ret_507(conv_loaded_int('signed int', a_523)) ;
  kill('struct P', p) ;
  pure(Unit) ;
  save ret_507: loaded integer (a_524: loaded integer:= Specified(0)) in
    pure(a_524)

