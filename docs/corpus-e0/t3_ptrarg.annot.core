            {-# <refined-cerberus/worktrees/dialect-e0/docs/corpus-e0/t3_ptrarg.c:1:20, refined-cerberus/worktrees/dialect-e0/docs/corpus-e0/t3_ptrarg.c:1:21> #-} let weak a_532: pointer =
              {-# <refined-cerberus/worktrees/dialect-e0/docs/corpus-e0/t3_ptrarg.c:1:20, refined-cerberus/worktrees/dialect-e0/docs/corpus-e0/t3_ptrarg.c:1:21> #-} pure(
